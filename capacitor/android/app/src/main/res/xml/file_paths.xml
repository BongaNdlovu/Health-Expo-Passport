<?xml version="1.0" encoding="utf-8"?>
<!-- What the app may hand to another app through its FileProvider: two dedicated folders, never the whole storage.
     Pictures/ in the app's own files is where Capacitor's WebView puts a photo taken for a file input; shared/ in the
     cache is for any file the app shares in future. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="captured_photos" path="Pictures/" />
    <cache-path name="shared" path="shared/" />
</paths>
