{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The public landing page: a static site of its own, separate from the app (../wrangler.jsonc serves ../dist).
  // Deploy from this folder:  npx wrangler deploy
  "name": "health-expo-passport",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  // range-worker.js runs only for the video (Safari needs byte ranges); every other path is served as a plain file.
  "main": "range-worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*.mp4"]
  }
}
